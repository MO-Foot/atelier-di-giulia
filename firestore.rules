rules_version = '2';

// Ogni account vede e modifica solo i propri dati (users/{uid} e le sottocartelle).
// Sostituisci TUA_EMAIL@gmail.com con l'indirizzo Google che userai per entrare:
// così nessun altro può usare il tuo database, anche se trova l'indirizzo dell'app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'TUA_EMAIL@gmail.com';
    }
  }
}
